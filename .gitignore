# ── Python ──
__pycache__/
*.pyc
.venv/
venv/
.venv-*/
*.egg-info/

# ── Modelos/pesos pesados (no versionar binarios grandes) ──
*.pt
*.onnx
*.weights
*.task
models/

# ── Entorno/secretos ──
.env
.env.local
.capture.env

# ── Captura temporal de frames para el spike de MediaPipe (runtime, se mueve al
# worktree del spike y no se queda ni se versiona aquí — ver BITACORA.md) ──
captured_frames/

# ── Fixtures reales de Fase B (fotos reales de JD tomadas en Fase A — nunca al repo,
# mismo criterio de privacidad que captured_frames/; ver tests/test_detector.py y
# BITACORA.md "Fase B". Los tests que dependen de esta carpeta se saltan (skip) si no
# está presente, así el resto del suite sigue corriendo en un clon limpio) ──
tests/fixtures_real/

# ── Fase C2: caché de secuencias crudas derivadas de los frames reales (regenerable
# con benchmarks/cache_raw_sequences.py, 552KB, no aporta nada versionado que no
# pueda recalcularse de los fixtures/sesiones reales, que ya están gitignoreados) ──
benchmarks/raw_sequences_cache.json

# ── OS ──
.DS_Store
Thumbs.db

# ── IDE ──
.vscode/

# ── Logs del bridge (runtime, no versionar) ──
logs/

# ── Fase D: logs de corridas de prueba (runtime, no versionar -- ver BITACORA.md) ──
benchmarks/*.log
benchmarks/fase_d_frames_*/

# ── Segundo cerebro — Graphify/Obsidian (tooling de desarrollo local, nunca al repo) ──
graphify-out/
.agent/rules/graphify.md
.agent/workflows/graphify.md
.agents/
.mcp.json
.graphifyignore
